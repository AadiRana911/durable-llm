# llmrun environment
#
# Copy this file to `.env` and edit it:
#
#     cp .env.example .env
#
# `.env` is gitignored. The Makefile loads it automatically; the library itself only ever
# reads real environment variables, so outside of `make` you need to export them yourself
# (`set -a; source .env; set +a`). Keep the syntax plain KEY=value -- no quotes, no spaces
# around the `=`, no shell expansion.

# Postgres connection string used by every command (`llmrun migrate`, `worker`, `enqueue`,
# `runs`, `costs`) and by the test suite. This default matches docker-compose.yml, which
# publishes Postgres on host port 55432 to avoid colliding with a local 5432.
LLMRUN_DATABASE_URL=postgresql://llmrun:llmrun@localhost:55432/llmrun

# Default provider adapter when `--provider` is not passed.
#   echo      - deterministic, offline, zero cost, no API key. Used by `make demo` and the
#               chaos suite, and the reason a reviewer can clone and run in 90 seconds.
#   anthropic - the real adapter. Requires `uv sync --extra anthropic` and a key below.
LLMRUN_PROVIDER=echo

# Only needed when LLMRUN_PROVIDER=anthropic (or `--provider anthropic`). Leave empty
# otherwise -- nothing in the default demo, test, or chaos paths touches the network.
ANTHROPIC_API_KEY=
